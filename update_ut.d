#!/usr/bin/env rdmd

import std.algorithm;
import std.array;
import std.ascii;
import std.conv;
import std.file;
import std.path;
import std.process;
import std.range;
import std.regex;
import std.stdio;
import std.string;
import logger = std.experimental.logger;

void main(string[] args) {
    const root = getcwd();
    const this_dir = __FILE_FULL_PATH__.dirName;
    const ut_src = buildPath(this_dir, "vendor", "unit-threaded");
    const gen_ut = buildPath(this_dir, "vendor", "unit-threaded", "gen_ut_main");

    {
        chdir(ut_src);
        scope (exit)
            chdir(root);
        spawnProcess(["dub", "build", "-c", "gen_ut_main"]).wait;
    }

    const caller_root = buildPath(root, args[1]).dirName.dirName;
    const ut_dir = args[1].dirName;
    // gen_ut_main runs `dub describe -c unittest` and then stats every file
    // the describe output lists, including the generated build/dub_test_root.d.
    // On a fresh tree that file does not exist yet (it is only written below,
    // after gen_ut_main succeeded), so hand that step an empty placeholder to
    // stat; the real content overwrites it later in this same run.
    const dtr = buildPath(ut_dir, "dub_test_root.d");
    if (!dtr.exists)
        std.file.write(dtr,
                "module dub_test_root;\nimport std.typetuple;\nalias allModules = TypeTuple!();\n");
    {
        chdir(caller_root);
        scope (exit)
            chdir(root);
        spawnProcess([gen_ut, "-f", args[1]]).wait;
    }

    // nusilly's silly.d (unit-threaded 2.1.9, compiled with -unittest as a
    // dependency source) requires a `dub_test_root` module. dub only generates
    // it for test targets without a custom main; this project's unittest
    // config has its own main (build/ut.d), so emit it here from the same
    // module list the generator just wrote into build/ut.d.
    const ut = readText(args[1]);
    const mods = matchAll(ut, regex("\"([^\"]+)\"")).map!(m => m.hit.strip('"')).array;

    // gen_ut_main derives module names from file paths (dub describe has no
    // module names) and cannot strip the calling project's sourcePath prefix,
    // so fix the generated names up here: drop the build/ helper files (not
    // test modules) and strip the test project's "source/" prefix. No-op for
    // the root project, whose generated names are already correct.
    const fixed = mods.filter!(m => !m.startsWith("build."))
        .map!(m => m.startsWith("source.") ? m["source.".length .. $] : m)
        .array;

    // rewrite ut.d with the corrected module list (runTestsMain reflects on
    // these names; wrong names fail to resolve at runtime)
    {
        auto uf = File(args[1], "w");
        uf.writeln("//" ~ fixed.join(","));
        uf.writeln("//Automatically generated by unit_threaded.gen_ut_main, do not edit by hand.");
        uf.writeln("import unit_threaded.runner : runTestsMain;");
        uf.writeln();
        uf.write("mixin runTestsMain!(");
        uf.write(fixed.map!(m => "\"" ~ m ~ "\"").join(","));
        uf.writeln(");");
        uf.close();
    }

    auto f = File(buildPath(ut_dir, "dub_test_root.d"), "w");
    f.writeln("module dub_test_root;");
    f.writeln("import std.typetuple;");
    foreach (m; fixed)
        f.writefln("static import %s;", m);
    f.writeln();
    f.write("alias allModules = TypeTuple!(\n");
    f.write(fixed.join(",\n"));
    f.writeln("\n);");
    f.close();
}
