name "code_checker"
description "Tool to check the quality of code for a review/inspection/PR"
authors "Joakim Brännström"
copyright "Copyright © 2018, Joakim Brännström"
license "BSL-1.0"

targetPath "build"

dependency "mylib" version="~>1.0.3" default=true
dependency "colorlog" version="~>1.0.0"  default=true
dependency "toml" version="~>1.0.0-rc.3"  default=true
dependency "compile_db" version="~>0.0.7" default=true
dependency "miniorm" version="~>0.0.10" default=true
dependency "dyaml" version="~>0.10.0"  default=true
dependency "tinyendian" version="~>0.2.0"  default=true
dependency "nusilly" version="~>1.0.0" default=true

configuration "application" {
    targetType "executable"
}

configuration "unittest" {
    targetName "code_checker_ut"
    excludedSourceFiles "source/app.d"
}

// Library configuration for the test project (test/dub.sdl): all
// first-class configurations are executables, which dub does not compile
// and link into dependents.
configuration "library" {
    targetType "library"
    excludedSourceFiles "source/app.d"
}

// Runs test/redirect.d, whose main redirects testing to the test/ subdirectory.
configuration "integration_test" {
    targetType "executable"
    targetName "integration_test"
    excludedSourceFiles "source/*"
    sourceFiles "test/redirect.d"
}
