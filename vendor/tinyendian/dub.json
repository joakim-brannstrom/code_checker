	"license": "Boost 1.0",
	"copyright": "Copyright © 2014, Ferdinand Majerech",
	"name": "tinyendian",
	"sourcePaths": [
		"source/"
	],
	"description": "Lightweight endianness handling library",
	"homepage": "https://github.com/kiith-sa/tinyendian",
	"importPaths": [
		"source"
	],
	"version": "0.2.0",
	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode",
				"debugInfoC"
			]
		},
		"release": {
			"buildOptions": [
				"releaseMode",
				"inline",
				"noBoundsCheck",
				"optimize"
			]
		},
		"profile": {
			"buildOptions": [
				"releaseMode",
				"debugInfoC",
				"noBoundsCheck",
				"optimize"
			]
		}
	},
	"configurations": [
		{
			"targetType": "library",
			"name": "library"
		}
	]
}